@import io.github.rygel.stellar.web.SubmitPostPage
@import io.github.rygel.outerstellar.platform.web.Page
@param model: Page<SubmitPostPage>

@template.io.github.rygel.outerstellar.platform.web.LayoutRouter(shell = model.shell, content = @`
<div class="max-w-2xl mx-auto">
    <h1 class="text-xl font-semibold text-[var(--text)] mb-4">
        Create a post in r/${model.data.communityName}
    </h1>

    <form method="post" action="/r/${model.data.communityName}/posts"
          class="p-6 bg-[var(--surface)] rounded-lg border border-[var(--border)]">

        <div class="mb-4">
            <label class="block text-sm font-medium text-[var(--text)] mb-1">Title</label>
            <input type="text" name="title" required maxlength="300"
                   placeholder="An interesting title"
                   class="w-full p-3 rounded border border-[var(--border)] bg-[var(--input-bg)] text-[var(--text)] text-sm">
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-[var(--text)] mb-1">URL (optional, for link posts)</label>
            <input type="url" name="url"
                   placeholder="https://..."
                   class="w-full p-3 rounded border border-[var(--border)] bg-[var(--input-bg)] text-[var(--text)] text-sm">
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-[var(--text)] mb-1">Body (optional)</label>
            <textarea name="body" rows="8"
                      placeholder="Text (optional)"
                      class="w-full p-3 rounded border border-[var(--border)] bg-[var(--input-bg)] text-[var(--text)] resize-y text-sm"></textarea>
        </div>

        <div class="flex justify-end gap-3">
            <a href="/r/${model.data.communityName}"
               class="px-4 py-2 text-sm text-[var(--text-muted)] hover:bg-[var(--surface-hover)] rounded-full">
                Cancel
            </a>
            <button type="submit"
                    class="px-6 py-2 bg-[var(--accent)] text-white rounded-full text-sm font-medium hover:opacity-90">
                Post
            </button>
        </div>
    </form>
</div>
`)
