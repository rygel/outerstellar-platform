@import java.util.UUID
@param communityId: UUID
@param communityName: String
@param isSubscribed: Boolean

<button hx-post="/r/${communityName}/subscribe"
        hx-target="#subscribe-btn"
        hx-swap="innerHTML"
        class="px-4 py-2 rounded-full text-sm font-medium border ${if (isSubscribed) "border-[var(--border)] text-[var(--text)] hover:border-red-500 hover:text-red-500" else "bg-[var(--accent)] text-white border-transparent hover:opacity-90"}">
    ${if (isSubscribed) "Joined" else "Join"}
</button>
